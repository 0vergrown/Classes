{
  "type": "apoli:multiple",
  "tick": {
    "type": "apoli:action_over_time",
    "interval": 1,
    "entity_action": {
      "type": "apoli:if_else",
      "condition": {
        "type": "apoli:sneaking"
      },
      "if_action": {
        "type": "apoli:and",
        "actions": [
          {
            "type": "apoli:modify_resource",
            "resource": "origins-classes:stealth",
            "modifier": {
              "operation": "add_base_early",
              "value": 1
            }
          },
          {
            "type": "apoli:if_else",
            "condition": {
              "type": "apoli:all_of",
              "conditions": [
                {
                  "type": "apoli:resource",
                  "resource": "origins-classes:stealth",
                  "comparison": ">=",
                  "compare_to": 200
                },
                {
                  "type": "apoli:status_effect",
                  "effect": "origins-classes:stealth",
                  "inverted": true
                }
              ]
            },
            "if_action": {
              "type": "apoli:apply_effect",
              "effect": {
                "effect": "origins-classes:stealth",
                "duration": 33000,
                "amplifier": 0,
                "is_ambient": false,
                "show_particles": false,
                "show_icon": true
              }
            }
          }
        ]
      },
      "else_action": {
        "type": "apoli:and",
        "actions": [
          {
            "type": "apoli:modify_resource",
            "resource": "origins-classes:stealth",
            "modifier": {
              "operation": "set_base",
              "value": 0
            }
          },
          {
            "type": "apoli:if_else",
            "condition": {
              "type": "apoli:status_effect",
              "effect": "origins-classes:stealth"
            },
            "if_action": {
              "type": "apoli:clear_effect",
              "effect": "origins-classes:stealth"
            }
          }
        ]
      }
    }
  },
  "reset_on_attack": {
    "type": "apoli:modify_damage_dealt",
    "damage_condition": {
      "type": "apoli:type",
      "damage_type": "minecraft:player_attack"
    },
    "self_action": {
      "type": "apoli:modify_resource",
      "resource": "origins-classes:stealth",
      "modifier": {
        "operation": "set_base",
        "value": 0
      }
    }
  }
}
